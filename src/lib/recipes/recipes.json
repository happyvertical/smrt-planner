    {
      "id": "inventory.stock",
      "section": {
        "id": "catalog",
        "label": "Catalog"
      },
      "label": "Inventory",
      "summary": "Keep count of how many of each product you have.",
      "synonyms": [
        "stock",
        "quantity",
        "on hand"
      ],
      "models": [
        "@happyvertical/smrt-inventory:StockLevel",
        "@happyvertical/smrt-inventory:InventoryLocation",
        "@happyvertical/smrt-inventory:StockMovement"
      ],
      "nav": [
        {
          "label": "Stock levels",
          "model": "@happyvertical/smrt-inventory:StockLevel"
        },
        {
          "label": "Locations",
          "model": "@happyvertical/smrt-inventory:InventoryLocation"
        },
        {
          "label": "Stock movements",
          "model": "@happyvertical/smrt-inventory:StockMovement"
        }
      ],
      "requires": [],
      "requiresAny": [
        [
          "products.simple",
          "products.clothing"
        ]
      ],
      "extends": [
        {
          "form": "product.simple",
          "records": [
            {
              "as": "sku",
              "model": "@happyvertical/smrt-products:Sku",
              "match": {
                "productId": {
                  "ref": "product"
                }
              },
              "values": {
                "code": "{product.name|slug}",
                "name": "{product.name}",
                "attributes": "{}",
                "active": true
              }
            },
            {
              "as": "location",
              "model": "@happyvertical/smrt-inventory:InventoryLocation",
              "match": {
                "code": "MAIN"
              },
              "values": {
                "name": "Main warehouse",
                "kind": "warehouse"
              }
            },
            {
              "as": "stock",
              "model": "@happyvertical/smrt-inventory:StockLevel",
              "match": {
                "skuId": {
                  "ref": "sku"
                },
                "locationId": {
                  "ref": "location"
                },
                "state": "available"
              }
            }
          ],
          "fields": [
            {
              "id": "quantity",
              "label": "Quantity",
              "to": "stock.qty",
              "default": 0
            }
          ]
        },
        {
          "form": "product.clothing",
          "records": [
            {
              "as": "location",
              "model": "@happyvertical/smrt-inventory:InventoryLocation",
              "match": {
                "code": "MAIN"
              },
              "values": {
                "name": "Main warehouse",
                "kind": "warehouse"
              }
            },
            {
              "as": "stock",
              "model": "@happyvertical/smrt-inventory:StockLevel",
              "match": {
                "skuId": {
                  "ref": "sku"
                },
                "locationId": {
                  "ref": "location"
                },
                "state": "available"
              }
            }
          ],
          "fields": [
            {
              "id": "quantity",
              "label": "Quantity",
              "to": "stock.qty",
              "default": 0
            }
          ]
        }
      ],
      "options": {
        "@happyvertical/smrt-inventory:StockLevel": {
          "fields": {
            "reorderPoint": {
              "visibility": "hidden"
            },
            "reorderQuantity": {
              "visibility": "hidden"
            }
          }
        },
        "@happyvertical/smrt-inventory:InventoryLocation": {
