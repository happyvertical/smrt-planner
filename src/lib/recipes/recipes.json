    {
      "id": "commerce.customers",
      "section": {
        "id": "sales",
        "label": "Sales"
      },
      "label": "Customers",
      "summary": "Keep a list of the people and companies you sell to.",
      "synonyms": [
        "clients",
        "buyers",
        "accounts"
      ],
      "models": [
        "@happyvertical/smrt-commerce:Customer"
      ],
      "nav": [
        {
          "label": "Customers",
          "model": "@happyvertical/smrt-commerce:Customer"
        }
      ],
      "requires": [],
      "forms": [
        {
          "id": "customer.default",
          "kind": "field-map",
          "label": "Customer",
          "kindLabel": "Customer",
          "model": "@happyvertical/smrt-commerce:Customer",
          "records": [
            {
              "as": "profileType",
              "model": "@happyvertical/smrt-profiles:ProfileType",
              "match": {
                "name": "Customer"
              }
            },
            {
              "as": "profile",
              "model": "@happyvertical/smrt-profiles:Profile",
              "match": {
                "id": {
                  "ref": "customer",
                  "field": "profileId"
                }
              },
              "values": {
                "typeId": {
                  "ref": "profileType"
                }
              }
            },
            {
              "as": "customer",
              "model": "@happyvertical/smrt-commerce:Customer",
              "values": {
                "profileId": {
                  "ref": "profile"
                }
              }
            }
          ],
          "fields": [
            {
              "id": "name",
              "label": "Name",
              "to": "profile.name",
              "required": true
            },
            {
              "id": "email",
              "label": "Email",
              "to": "profile.email"
            },
            {
              "id": "status",
              "label": "Status",
              "to": "customer.status",
              "default": "active"
            },
            {
              "id": "customerType",
              "label": "Customer type",
              "to": "customer.customerType",
              "default": "dtc"
            },
            {
              "id": "paymentTerms",
              "label": "Payment terms",
              "to": "customer.paymentTerms"
            },
            {
              "id": "creditLimit",
              "label": "Credit limit",
              "to": "customer.creditLimit"
            },
            {
              "id": "taxExempt",
              "label": "Tax exempt",
              "to": "customer.taxExempt"
            },
            {
              "id": "taxId",
              "label": "Tax ID",
              "to": "customer.taxId"
            },
            {
              "id": "shippingAddress",
              "label": "Shipping address",
              "to": "customer.defaultShippingAddress"
            },
            {
              "id": "billingAddress",
              "label": "Billing address",
              "to": "customer.defaultBillingAddress"
            },
            {
              "id": "notes",
              "label": "Notes",
              "to": "customer.notes"
            }
          ]
        }
      ],
      "options": {
        "@happyvertical/smrt-commerce:Customer": {
          "fields": {
            "profileId": {
              "label": "Name",
              "order": -1
            }
          }
        }
      }
    },
